# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交到仓库）
# 获取方式：GitHub → Settings → Developer settings → Personal access tokens
#   - classic token：需勾选 repo 权限（Contents: Read and write）
#   - fine-grained token：仓库权限选 Contents: Read and write

# 必填（免密推送用）：GitHub 个人访问令牌
GITHUB_TOKEN=

# ---------- 以下均为可选，一般不需要修改 ----------
# 推送使用的远程仓库名
# PUBLISH_REMOTE=origin
# main 分支名
# PUBLISH_MAIN=main
# gh-pages 部署分支名
# PUBLISH_GH=gh-pages
# 构建产物目录
# PUBLISH_DIST=dist
